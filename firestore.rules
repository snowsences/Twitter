rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'allenkevinc@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    match /users/{uid}/meta/settings {
      allow read, write: if owner(uid);
    }
    match /users/{uid}/profiles/{handle} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['profile', 'chunks', 'version'])
        && request.resource.data.profile.handle == handle
        && request.resource.data.chunks is list
        && request.resource.data.chunks.size() <= 5000
        && request.resource.data.version is string;
    }
    match /users/{uid}/chunks/{hash} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['payload'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 700000;
    }
  }
}
